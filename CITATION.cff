    value: "10.5281/zenodo.23002848"
    description: "Concept DOI — always resolves to the latest version"
  - type: doi
    value: "10.5281/zenodo.23002849"
    description: "DOI of version 1.0.0"
keywords:
  - checkers
  - draughts
